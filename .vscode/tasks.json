{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Mergington WebApp",
			"type": "shell",
			"command": ".venv/bin/python",
			"args": [
				"-m",
				"uvicorn",
				"src.app:app",
				"--reload",
				"--host",
				"0.0.0.0",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}